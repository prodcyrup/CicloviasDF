{
  "name": "eixoverde",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "EixoVerde — Navegação inteligente, planejamento seguro em ciclovias e telemetria para mobilidade elétrica e ciclismo no Brasil.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "python3 -u tests/e2e/run_e2e.py",
    "optimize:geo": "python3 scripts/optimize-geojson.py"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "lucide-react": "^0.487.0",
    "maplibre-gl": "^5.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.8",
    "tailwindcss": "^4.1.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.6",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^5.1.1"
  }
}
