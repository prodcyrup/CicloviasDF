# EixoVerde — Optional Free-Tier API Keys
# The app automatically falls back to free zero-key providers (OpenFreeMap + BRouter/OSRM)
# whenever these keys are left empty.

# MapTiler Cloud (https://cloud.maptiler.com/) — Vector Light/Dark/Satellite + 3D buildings
VITE_MAPTILER_KEY=

# OpenRouteService (https://openrouteservice.org/dev/#/signup) — 2,000 free cycling routes/day with elevation & waytypes
# Optional when Supabase ors-proxy Edge Function is deployed (keeps ORS_API_KEY server-side)
VITE_ORS_KEY=

# Supabase (https://supabase.com/dashboard) — Optional Phase 2 Cloud Accounts, Offline-First Sync & ORS Proxy
# Leave both empty to run in 100% functional Guest/Local IndexedDB mode (zero cloud requests).
VITE_SUPABASE_URL=
# Accepts BOTH modern Supabase Publishable keys (sb_publishable_...) and legacy anon JWT keys (eyJ...).
# SECURITY: NEVER put service_role or sb_secret_... keys in frontend VITE_* variables!
VITE_SUPABASE_ANON_KEY=
